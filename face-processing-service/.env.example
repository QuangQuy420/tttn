PORT=8000
# S3 (local = MinIO, S3-compatible). Switch endpoint to real S3 with no code change.
S3_ENDPOINT=http://minio:9000
# Browser-facing endpoint for presigned URLs — `minio` is only resolvable inside the Docker
# network, so a URL signed against S3_ENDPOINT would fail to load in a browser on the host.
# MinIO's S3 API port (9000) is published to the host in infra/docker-compose.yml, so
# localhost:9000 reaches the same server. Mirrors product-service's MINIO_PUBLIC_URL.
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_BUCKET=face-images
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1

# Postgres (async SQLAlchemy engine — note the +asyncpg driver suffix)
DATABASE_URL=postgresql+asyncpg://app:app@postgres:5432/face_processing_db

# Face-shape classifier: "ml" (trained model, default) or "rule" (old threshold rules).
FACE_SHAPE_CLASSIFIER=ml
# Folder name under models/face_shape/ — changing it switches the served model.
FACE_SHAPE_MODEL_VERSION=fs-20260930-svm
# Reject photos where the head is turned sideways more than this many degrees.
FACE_MAX_YAW_DEG=25
# Reject photos where the face is too small (cheekbone width in pixels, same as training).
FACE_MIN_CHEEK_PX=80

# Shared secret for /internal/* calls (`X-Internal-Key`) — same value as recommendation-service.
INTERNAL_API_KEY=
