PORT=3001
DATABASE_URL=postgresql://app:app@postgres:5432/auth_db
# Must be valid Base64 (JwtUtil decodes it with io.jsonwebtoken's Decoders.BASE64) and long
# enough for HS256 (>= 32 raw bytes) — generate your own with `openssl rand -base64 48`.
# PLACEHOLDER (Base64 of "REPLACE-ME-local-dev-only-jwt-secret-placeholder") — replace it in
# .env, with the same value in api-gateway/.env. Startup fails when it is blank.
JWT_SECRET=UkVQTEFDRS1NRS1sb2NhbC1kZXYtb25seS1qd3Qtc2VjcmV0LXBsYWNlaG9sZGVy
JWT_EXPIRES_IN=1d
# Shared secret for service-to-service calls to this service's /internal/** endpoints (checked
# against the X-Internal-Key header). Must match api-gateway/.env's INTERNAL_API_KEY exactly —
# kept in sync by hand across both services' .env files, same as JWT_SECRET above.
# Placeholder — replace it. Startup fails when it is blank.
INTERNAL_API_KEY=change-me-in-.env
