PORT=3003
DATABASE_URL=postgresql://app:app@postgres:5432/order_db
REDIS_URL=redis://redis:6379
PRODUCT_SERVICE_URL=http://product-service:3002

# --- RabbitMQ (event bus — checkout saga: stock reserve/release, payment create/reply) ---
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# --- Checkout saga reconciliation/dead-letter (dev/test tuning — safe defaults for local use) ---
# Số lần RabbitMQ redeliver 1 message saga tối đa trước khi đẩy vào dead-letter queue. Hạ số này
# xuống thấp (vd 2) để test SAGA_CHAOS_MODE=FORCE_DEAD_LETTER nhanh hơn, không phải chờ lâu.
# → Chỉ ảnh hưởng khi SAGA_CHAOS_MODE=FORCE_DEAD_LETTER; 2 mode STUCK_* không dùng biến này.
SAGA_QUEUE_DELIVERY_LIMIT=10
# Chu kỳ chạy của SagaReconciliationJob (mili-giây) — job quét các đơn đang PENDING/AWAITING_PAYMENT
# để tìm đơn bị "kẹt" (không nhận được phản hồi saga). 60000 = quét mỗi 60 giây.
# → Chỉ ảnh hưởng khi SAGA_CHAOS_MODE=STUCK_STOCK_RESERVE hoặc STUCK_PAYMENT (đơn chỉ "kẹt" khi 2
# mode này chặn publish); FORCE_DEAD_LETTER không đi qua job này nên không bị ảnh hưởng.
RECONCILIATION_JOB_INTERVAL_MS=60000
# Một đơn phải "im lặng" (không có phản hồi/lần thử nào mới) ít nhất bao nhiêu phút thì job mới
# coi là "kẹt" và bắt đầu gửi lại lệnh saga. Vì mỗi lần thử lại đều reset lại mốc thời gian này,
# nên khoảng cách thực tế giữa các lần thử lại là ~giá trị này, không phải theo mỗi lần job chạy.
# → Chỉ ảnh hưởng khi SAGA_CHAOS_MODE=STUCK_STOCK_RESERVE hoặc STUCK_PAYMENT.
RECONCILIATION_STUCK_THRESHOLD_MINUTES=2
# Số lần job được phép tự động gửi lại lệnh saga cho 1 đơn trước khi bỏ cuộc. Sau lần thử cuối
# cùng không thành công, đơn bị đánh dấu reconciliationExhausted=true và job sẽ không bao giờ
# đụng vào đơn đó nữa (chỉ còn log cảnh báo RECONCILIATION_EXHAUSTED, không tự phục hồi được).
# → Chỉ ảnh hưởng khi SAGA_CHAOS_MODE=STUCK_STOCK_RESERVE hoặc STUCK_PAYMENT.
RECONCILIATION_MAX_ATTEMPTS=3
# Cờ giả lập lỗi saga, chỉ dùng để test (xem SagaChaosMode.java). NONE (mặc định) = không ảnh
# hưởng gì. STUCK_STOCK_RESERVE / STUCK_PAYMENT = bước gửi tương ứng âm thầm "thành công" mà
# không gửi thật, khiến đơn bị kẹt để quan sát log retry/hết lượt thử của SagaReconciliationJob.
# → 2 mode này chịu ảnh hưởng bởi RECONCILIATION_JOB_INTERVAL_MS/STUCK_THRESHOLD_MINUTES/MAX_ATTEMPTS
# ở trên (không liên quan SAGA_QUEUE_DELIVERY_LIMIT).
# FORCE_DEAD_LETTER = mọi sự kiện saga trả về đều xử lý thất bại cho tới khi bị đẩy vào
# dead-letter queue. → Mode này chịu ảnh hưởng bởi SAGA_QUEUE_DELIVERY_LIMIT ở trên (không liên
# quan 3 biến RECONCILIATION_*, vì nó không đi qua SagaReconciliationJob).
# Nhớ đổi lại NONE và restart order-service sau khi test xong.
SAGA_CHAOS_MODE=NONE
