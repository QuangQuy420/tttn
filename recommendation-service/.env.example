PORT=8000
PRODUCT_SERVICE_URL=http://product-service:3002
# HTTP timeout (seconds) for calls to product-service before treated as unreachable.
PRODUCT_SERVICE_TIMEOUT_SECONDS=5.0

# recommendation_db — async SQLAlchemy URL (behavior event store).
DATABASE_URL=postgresql+asyncpg://app:app@postgres:5432/recommendation_db
# RabbitMQ — credentials must match infra/.env RABBITMQ_USER / RABBITMQ_PASSWORD.
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
# Set to false to skip the behavior-events consumer (e.g. in tests).
BEHAVIOR_CONSUMER_ENABLED=true
# Quorum queue x-delivery-limit before a message is dead-lettered to behavior-events.dlq.
BEHAVIOR_QUEUE_DELIVERY_LIMIT=10
BEHAVIOR_PREFETCH=20
# Set to false to skip the product-events consumer (catalog cache invalidation; e.g. in tests).
PRODUCT_CONSUMER_ENABLED=true
# Redis for the product catalog cache — unreachable Redis = cache bypassed, not an error.
REDIS_URL=redis://redis:6379/0
# Shared secret for /internal/* endpoints (X-Internal-Key header) — same value as infra/.env.
INTERNAL_API_KEY=

# Hybrid ranking weights: finalScore = RANK_ALPHA * preferenceScore + RANK_BETA * faceFitScore.
RANK_ALPHA=0.6
RANK_BETA=0.4
# Preference scale before the weights: none = calibrated score as is,
# rank = rank over the candidate list scaled to [0, 1] (top = 1).
# rank with 0.6 / 0.4 is a product choice, not the experiment's val-selected config
# (see ml/recommendation/reports/hybrid/SUMMARY.md).
PREFERENCE_NORM=rank
# Preference model folder under models/preference/ (loaded at startup; the app refuses to
# start if it is missing or its feature_schema_version differs from the code).
# Empty = legacy mode: no model, preference = popularity, alpha = 0.
PREFERENCE_MODEL_VERSION=v1-sim-20261110-xgbrank
# face-processing-service internal API (user's latest / chosen face analysis, X-Internal-Key).
FACE_PROCESSING_SERVICE_URL=http://face-processing-service:8000
# HTTP timeout (seconds) for face-processing calls — on timeout the face part is skipped (beta = 0).
FACE_PROCESSING_TIMEOUT_SECONDS=2.0
# Cache lifetime (seconds): product catalog in Redis (also invalidated by product-events)
# and global product stats in process.
CATALOG_TTL_SECONDS=300
# Diversity caps on the top-10 of GET /recommendations/for-you.
MAX_PER_FRAME_SHAPE=3
MAX_PER_BRAND=3
