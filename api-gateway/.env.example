# API Gateway (North-South entry point)
PORT=8080
CORS_ORIGIN=http://localhost:3000

# JWT verification at the edge
JWT_SECRET=change-me-in-.env

# Internal service-to-service auth (must match INTERNAL_API_KEY of user-service,
# face-processing-service and recommendation-service exactly)
INTERNAL_API_KEY=change-me-in-.env

# Downstream services (East-West, internal REST)
USER_SERVICE_URL=http://user-service:3001
PRODUCT_SERVICE_URL=http://product-service:3002
ORDER_SERVICE_URL=http://order-service:3003
FACE_PROCESSING_SERVICE_URL=http://face-processing-service:8000
RECOMMENDATION_SERVICE_URL=http://recommendation-service:8000

# RabbitMQ — behavior events (VIEW / TRY_ON from web) are published to the `behavior-events` exchange
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672

# Redis — permissions cache (perm:{userId}, TTL below). Redis down = cache bypassed, gateway keeps working
REDIS_URL=redis://redis:6379
PERMISSIONS_CACHE_TTL_SECONDS=60

# Rate limit (per user when the JWT is valid, else per IP; window in ms). Over the limit → 429
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_DEFAULT=100
RATE_LIMIT_AUTH=5
RATE_LIMIT_FACE_ANALYZE=10
RATE_LIMIT_EVENTS=60
